# 复制本文件为 .env，并替换为自己的密钥与连接信息。

# 大模型（沿用 FinRAG 的 DeepSeek/OpenAI 兼容配置）
LLM_MODEL=deepseek-chat
LLM_API_KEY=change_me
LLM_BASE_URL=https://api.deepseek.com

# Neo4j 图数据库
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me

# 嵌入模型路径（可复用 FinRAG 的 bge 模型目录，例如 ../FinRAG/RAG-DEV/rag_qa/models/bge-m3）
EMBEDDING_MODEL_PATH=./models/bge-large-zh-v1.5

# 即梦文生图（宠物配图生成）
JIMENG_AK=change_me
JIMENG_SK=change_me
